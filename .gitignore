# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Logs
logs/*.txt
logs/*.log
# fvtt e2e runs (reports, screenshots): local evidence, not repo content
logs/e2e/
# release:check reports (local data paths inside) and the zip it builds
logs/release/
# scratch evidence from preview/recording sessions
logs/recording-prep/

# Icon review queue (dev/icons/review): the tool, its manifest, the GM's feedback and each
# batch's prompts are tracked; generated candidate images (~60 MB — approved ones are copied
# into icons/) and snapshots of the live world's items stay local.
dev/icons/review/candidates/**/raw/
dev/icons/review/candidates/**/*.png
dev/icons/review/candidates/**/*.svg
dev/icons/review/candidates/**/*.webp
dev/icons/review/candidates/**/*.jpg
dev/icons/review/audits/
dev/icons/review/review-preview.png
# NOT a bare `*.log` — LevelDB names its write-ahead log `NNNNNN.log`, and that
# is where a freshly built pack's documents live until a later open compacts
# them into a `.ldb`. Ignoring it committed `lekarstwa` and `sztuczki` as empty
# directories. Keep any new log rule anchored to a directory.

# Python (dev tooling venv, e.g. dev/icons, dev/bestiary scripts)
.venv/
__pycache__/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
*.bak
*.tmp

# FoundryVTT runtime artifacts
*.lock
# LevelDB compendium lock (bare filename, held by the process with the pack
# open — Windows denies read access while FVTT is running). Not content.
packs/*/LOCK
