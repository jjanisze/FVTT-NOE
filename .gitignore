# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Logs
logs/*.txt
logs/*.log
# NOT a bare `*.log` — LevelDB names its write-ahead log `NNNNNN.log`, and that
# is where a freshly built pack's documents live until a later open compacts
# them into a `.ldb`. Ignoring it committed `lekarstwa` and `sztuczki` as empty
# directories. Keep any new log rule anchored to a directory.

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
*.bak
*.tmp

# FoundryVTT runtime artifacts
*.lock
# LevelDB compendium lock (bare filename, held by the process with the pack
# open — Windows denies read access while FVTT is running). Not content.
packs/*/LOCK
