<li class="member" data-uuid="{{ uuid }}">
    <div class="vitals card" {{#if underlay}}style="--underlay: {{ underlay }}"{{/if}}>
        {{#if isPrimaryVehicle}}
        <i class="fa-duotone fa-solid fa-circle-star primary-vehicle" data-tooltip
           aria-label="{{ localize "DND5E.Group.Vehicle.Primary.label" }}"></i>
        {{/if}}
        <div class="portrait">
            {{#if portrait.isVideo}}
            <video src="{{ portrait.src }}" autoplay muted playsinline disablepictureinpicture loop></video>
            {{else}}
            <img src="{{ portrait.src }}" alt="{{ name }}">
            {{/if}}
        </div>
        <div class="bars">
            <strong class="name">
                <a {{#if canView}}data-action="showDocument"{{/if}} data-uuid="{{ uuid }}">
                    {{ name }}
                </a>
            </strong>
            {{#with system.attributes.hp}}
            {{#if max}}
            <div class="hp-bar bar">
                <label>PW</label>
                <div class="meter hit-points progress" role="meter" aria-valuemin="0"
                     aria-valuenow="{{ value }}" aria-valuemax="{{ max }}"
                     style="--bar-percentage: {{ pct }}%"></div>
                <div class="values">
                    {{#unless ../hiddenStats}}
                    <span class="value">{{ value }}</span>
                    <span class="separator">&sol;</span>
                    <span class="max">{{ max }}</span>
                    {{/unless}}
                </div>
            </div>
            {{/if}}
            {{/with}}

            {{!-- KW dzieli linijkę z Wyczerpaniem i Zranieniem: trzy równe segmenty. --}}
            <div class="neuro-stan-linia{{#if paliwo}} is-paliwo{{/if}}">
                {{#with paliwo}}
                <div class="neuro-seg neuro-seg-paliwo"
                     data-tooltip="Paliwo w baku: {{ value }} / {{ max }} l · {{ spalanie }} l/100 km · zasięg {{ zasieg }} km">
                    <label>PAL</label>
                    <div class="meter progress" role="meter" aria-valuemin="0"
                         aria-valuenow="{{ value }}" aria-valuemax="{{ max }}"
                         style="--bar-percentage: {{ pct }}%"></div>
                    <span class="values">{{ value }}/{{ max }} l</span>
                </div>
                {{/with}}
                {{#with system.attributes.hd}}
                <div class="neuro-seg neuro-seg-hd" data-tooltip="Kości Wytrzymałości: {{ value }}/{{ max }}">
                    <label>KW</label>
                    <div class="meter hit-dice progress" role="meter" aria-valuemin="0"
                         aria-valuenow="{{ value }}" aria-valuemax="{{ max }}"
                         style="--bar-percentage: {{ pct }}%"></div>
                    <span class="values">{{#unless ../hiddenStats}}{{ value }}/{{ max }}{{/unless}}</span>
                </div>
                {{/with}}
                {{#each tracks}}
                <div class="neuro-seg neuro-seg-track neuro-seg-{{ id }}" data-tooltip="{{ tooltip }}">
                    <label>{{ short }}</label>
                    <div class="neuro-seg-pips">
                        {{#each pips}}
                        <button type="button" class="neuro-seg-pip {{#if filled}}is-filled{{/if}}{{#if terminal}} is-terminal{{/if}}"
                                data-action="neuroTrackPip" data-track-id="{{ ../id }}" data-n="{{ n }}"
                                {{#if color}}style="--neuro-pip-color: {{ color }}"{{/if}}
                                data-tooltip="{{ tooltip }}"></button>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>

            {{#if properties.length}}
            <ul class="pills">
                {{#each properties}}
                <li class="pill transparent">
                    <span class="label">{{ localize label }}</span>
                    <span class="separator">|</span>
                    <span class="value">{{ value }}</span>
                </li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        <div class="classes controls">
            {{#if @root.editable}}
            <button type="button" class="config-button unbutton" data-action="removeMember" data-tooltip
                    aria-label="{{ localize "DND5E.Group.Action.Remove" }}">
                <i class="fa-solid fa-square-xmark" inert></i>
            </button>
            {{else}}
            {{#each classes}}
            <img class="item-tooltip" src="{{ img }}" alt="{{ name }}" data-uuid="{{ uuid }}"
                 data-action="showDocument" data-tooltip-direction="RIGHT">
            {{#with subclass}}
            <img class="item-tooltip" src="{{ img }}" alt="{{ name }}" data-uuid="{{ uuid }}"
                 data-action="showDocument" data-tooltip-direction="RIGHT">
            {{/with}}
            {{/each}}
            {{/if}}
        </div>
    </div>
    {{#if section.hasStats}}
    <div class="stats">
        {{#if hiddenStats}}
        <div class="empty">???</div>
        {{else}}
        <div class="info">
            <div>
                <i class="fa-solid fa-shield" data-tooltip aria-label="Trudność Trafienia"></i>
                <span class="value">{{ system.attributes.ac.value }}</span>
            </div>
            <div>
                <i class="fa-solid fa-shoe-prints" data-tooltip aria-label="Szybkość"></i>
                <span class="value">
                    {{ system.attributes.movement.walk }}
                    {{#if system.attributes.movement.slowed}}
                    <i class="fa-solid fa-triangle-exclamation" data-tooltip
                       aria-label="{{ localize "DND5E.TRAVEL.Slowed.Member" }}"></i>
                    {{/if}}
                </span>
            </div>
        </div>
        {{!-- Skradanie się ma w tym świecie klucz `skr`; natywny szablon pytał o `ste`. --}}
        <div class="info">
            <div>
                <a class="{{ skills.prc.css }}" data-action="roll" data-type="skill" data-key="prc"
                   data-tooltip aria-label="{{ skills.prc.label }}">
                    <i class="fa-solid fa-eye" inert></i>
                </a>
                <div class="skill">
                    <span class="roll">{{ dnd5e-formatModifier skills.prc.total }}</span>
                    <span class="passive">({{ skills.prc.passive }})</span>
                </div>
            </div>
            <div>
                <a class="{{ skills.skr.css }}" data-action="roll" data-type="skill" data-key="skr"
                   data-tooltip aria-label="{{ skills.skr.label }}">
                    <i class="fa-solid fa-hood-cloak" inert></i>
                </a>
                <div class="skill">
                    <span class="roll">{{ dnd5e-formatModifier skills.skr.total }}</span>
                    <span class="passive">({{ skills.skr.passive }})</span>
                </div>
            </div>
            <div>
                <a class="{{ skills.sur.css }}" data-action="roll" data-type="skill" data-key="sur"
                   data-tooltip aria-label="{{ skills.sur.label }}">
                    <i class="fa-solid fa-bow-arrow" inert></i>
                </a>
                <div class="skill">
                    <span class="roll">{{ dnd5e-formatModifier skills.sur.total }}</span>
                    <span class="passive">({{ skills.sur.passive }})</span>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
    {{/if}}
</li>
