{
  "name": "neuroshima-2026-overrides",
  "version": "1.0.0",
  "description": "Dev tooling (compendium/icon/token builders) for the Neuroshima 5e FoundryVTT module. Not the module's own version — that's module.json. No build step for the module itself: scripts/main.mjs is loaded by Foundry as-is (see DEV_GUIDE.md §4).",
  "scripts": {
    "test": "node dev/validate-tests.mjs && node dev/lang-check.mjs && npm run test:scenery && npm run --silent test:dnd5e6",
    "test:dnd5e6": "node dev/migration/dnd5e6-scan.mjs --quiet --fail-on=message-flags,effect-origin,deletion-syntax,rarity,effect-modes,scene-templates,damage-tray-api,death-save-details,v1-dialog,relative-uuid",
    "test:scenery": "node --test dev/e2e/nevada-stream.test.mjs",
    "fvtt": "node dev/agent/fvtt.mjs",
    "test:agent": "node --test \"dev/agent/test/*.test.mjs\"",
    "build:zip": "node dev/release/build-zip.mjs",
    "release:check": "node dev/release/release-check.mjs",
    "validate:tests": "node dev/validate-tests.mjs",
    "bump:version": "node dev/bump-version.mjs",
    "validate:css": "node dev/validate-css.mjs",
    "validate:recipes": "node dev/validate-recipes.mjs",
    "scan:dnd5e6": "node dev/migration/dnd5e6-scan.mjs",
    "build:packs": "node dev/packs/build-packs.mjs",
    "validate:packs": "node dev/packs/validate-packs.mjs",
    "build:icons": "node dev/icons/gen_class_placeholders.mjs",
    "build:status-icons": "node dev/icons/gen_status_numerals.mjs",
    "build:classes": "python dev/classes/gen_features.py && python dev/classes/gen_companions.py && npm run build:icons && npm run build:packs && npm run validate:packs",
    "build:token-templates": "python dev/icons/gen_token_template.py",
    "build:token-placeholders": "python dev/icons/gen_token_placeholders.py",
    "review:icons": "node dev/icons/review/server.mjs",
    "audit:icons": "node dev/icons/audit-live-items.mjs",
    "validate:icon-candidates": "python dev/icons/review/validate_candidates.py",
  "seed:token-scales": "python dev/icons/gen_scale_defaults.py",
    "extract:bestiary": "python dev/bestiary/extract_bestiary.py",
    "gen:bestiary": "python dev/bestiary/gen_bestiary.py",
    "build:bestiary": "npm run extract:bestiary && npm run gen:bestiary && node dev/packs/build-packs.mjs --only=bestiariusz"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs"
}
